# ==========================================================
# 🚀 StatIntel-AI Environment Configuration (.env.example)
# ==========================================================

# 1. Government Open Data API Keys
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# 2. Backend & Microservices URLs
BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1
ML_MODEL_URL=http://localhost:5000

# 3. Database & Cache Connections
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/statintel
REDIS_URL=redis://localhost:6379

# 4. AI & LLM Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 5. Security & Authentication
JWT_SECRET_KEY=statintel_production_super_secret_jwt_key_2026_sih
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DIGILOCKER_CLIENT_ID=your_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret

# 6. Deployment Environment
NODE_ENV=development
PORT=3000

# 7. iGOT Karmayogi (Sunbird ED/Lern) & Parichay SSO Integration
IGOT_MODE=mock
IGOT_BASE_URL=https://portal.igotkarmayogi.gov.in
IGOT_SANDBOX_URL=https://dev.karmayogibharat.net
IGOT_API_KEY=
IGOT_USER_TOKEN=
IGOT_ORG_ID=
IGOT_CHANNEL_ID=
PARICHAY_CLIENT_ID=
PARICHAY_CLIENT_SECRET=
PARICHAY_REDIRECT_URI=http://localhost:8000/api/v1/auth/parichay/callback
