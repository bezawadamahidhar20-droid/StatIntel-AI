APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="StatIntel AI — Backend"

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/statintel_db
SQLITE_TEST_URL=sqlite+aiosqlite:///:memory:

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security Configuration
JWT_SECRET=statintel_secret_key_change_in_production_32bytes_long!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini AI Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
USE_MOCK_AI=False

# External Provider Configuration
IGOT_API_URL=https://igot-karmayogi.gov.in/api/v1
IGOT_API_KEY=igot_mock_api_key

NSSTA_API_URL=https://nssta.gov.in/api/v1
NSSTA_API_KEY=nssta_mock_api_key

TPAC_API_URL=https://tpac.gov.in/api/v1
TPAC_API_KEY=tpac_mock_api_key

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
