# STATINTEL AI — ENVIRONMENT VARIABLES SPECIFICATION
# Copy this file to .env before starting backend

# ==============================================================================
# APPLICATION RUNTIME
# ==============================================================================
APP_ENV=development               # [OPTIONAL] development | staging | production
DEBUG=True                        # [OPTIONAL] True for auto-reload and verbose logging
API_V1_STR=/api/v1                # [OPTIONAL] API version prefix
PROJECT_NAME="StatIntel AI — Skill Intelligence Platform"

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Local zero-configuration SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./statintel.db
# Production PostgreSQL container connection string:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/statintel_db
SQLITE_TEST_URL=sqlite+aiosqlite:///:memory:

# ==============================================================================
# REDIS CACHE & RATE LIMITING
# ==============================================================================
REDIS_URL=redis://localhost:6379/0  # [OPTIONAL] Required only if Redis session caching enabled

# ==============================================================================
# JWT SECURITY & AUTHENTICATION
# ==============================================================================
JWT_SECRET=statintel_secret_key_change_in_production_32bytes_long!! # [REQUIRED in production: min 32 chars]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# GOOGLE GEMINI AI CONFIGURATION
# ==============================================================================
GEMINI_API_KEY=                     # [OPTIONAL: If empty, MockLLMProvider is safely used]
GEMINI_MODEL=gemini-3.1-flash-lite  # [OPTIONAL: Supported: gemini-3.1-flash-lite, gemini-3.6-flash, gemini-flash-latest]
USE_MOCK_AI=False                   # [OPTIONAL: Set True to force offline deterministic mock generation]

# ==============================================================================
# FILE UPLOAD CONSTRAINTS
# ==============================================================================
MAX_UPLOAD_SIZE_MB=10               # [OPTIONAL: Enforces 10MB limit on uploaded documents]
ALLOWED_EXTENSIONS=.pdf,.docx,.pptx,.txt

# ==============================================================================
# EXTERNAL GOVERNMENT PROVIDERS (iGOT, NSSTA, TPAC)
# ==============================================================================
IGOT_API_URL=https://igot-karmayogi.gov.in/api/v1
IGOT_API_KEY=igot_mock_api_key

NSSTA_API_URL=https://nssta.gov.in/api/v1
NSSTA_API_KEY=nssta_mock_api_key

TPAC_API_URL=https://tpAC.gov.in/api/v1
TPAC_API_KEY=tpac_mock_api_key

# ==============================================================================
# CORS POLICY
# ==============================================================================
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000"]
